Bootstrap: docker
From: python:3.12-slim

%files
    ../../pyproject.toml /build/jernerics/pyproject.toml
    ../../src/ /build/jernerics/src/
    pyproject.toml /build/project/pyproject.toml
    src/ /build/project/src/

%post
    pip install uv
    
    cd /build/jernerics
    uv pip install --system .
    
    cd /build/project
    uv pip install --system . --index-url https://download.pytorch.org/whl/cu121 --extra-index-url https://pypi.org/simple/
    
    rm -rf /build /root/.cache

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%runscript
    exec python -m container_gpu "$@"
